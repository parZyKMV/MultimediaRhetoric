                <div class="stat-row">
                    <span class="stat-key">Name</span>
                    <span class="stat-val-text">Kevin Mejía Vázquez</span>
                </div>
                <div class="stat-row">
                    <span class="stat-key">Location</span>
                    <span class="stat-val-text">Salt Lake City, Utah</span>
                </div>
                <div class="stat-row">
                    <span class="stat-key">Class</span>
                    <span class="stat-val-text">Game & Software Developer</span>
                </div>
                <div class="stat-row">
                    <span class="stat-key">Rank</span>
